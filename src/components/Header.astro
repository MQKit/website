---
import Icon from "./Icon.astro";
import DownloadButton from "./DownloadButton.astro";
import { APP_NAME, REPO } from "../site";

const nav = [
  { href: "/tools/", label: "Tools" },
  { href: "/download/", label: "Download" },
  { href: "/faq/", label: "FAQ" },
  { href: "/privacy/", label: "Privacy" },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${APP_NAME} home`}>
      <img src="/icon.svg" alt="" width="24" height="24" />
      <span>{APP_NAME}</span>
    </a>
    <nav class="nav" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}>{n.label}</a>)}
    </nav>
    <div class="end">
      <a class="icon-btn" href={REPO} aria-label="Source code on GitHub" title="Source code"><Icon name="github" size={18} /></a>
      <button class="icon-btn theme" type="button" aria-label="Switch light or dark">
        <Icon name="sun" class="sun" size={18} />
        <Icon name="moon" class="moon" size={18} />
      </button>
      <span class="dl"><DownloadButton small /></span>
      <button class="icon-btn menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
  <nav class="mobile" id="mobile-menu" aria-label="Menu">
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
  </nav>
</header>

<script>
  document.querySelector(".theme")!.addEventListener("click", () => {
    const root = document.documentElement;
    const sys = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    const cur = root.dataset.theme ?? sys;
    const next = cur === "dark" ? "light" : "dark";
    if (next === sys) {
      delete root.dataset.theme;
      try { localStorage.removeItem("theme"); } catch {}
    } else {
      root.dataset.theme = next;
      try { localStorage.setItem("theme", next); } catch {}
    }
  });
  const menu = document.querySelector<HTMLButtonElement>(".menu-btn")!;
  menu.addEventListener("click", () => {
    const open = menu.getAttribute("aria-expanded") !== "true";
    menu.setAttribute("aria-expanded", String(open));
    document.getElementById("mobile-menu")!.toggleAttribute("data-open", open);
  });
  // A Windows app: elsewhere, download buttons lead to the download page.
  if (!/Windows/i.test(navigator.userAgent)) {
    document.querySelectorAll<HTMLAnchorElement>("a[data-windows-only]").forEach((a) => (a.href = "/download/"));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 58px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
  }
  .brand img {
    border-radius: 6px;
  }
  .nav {
    display: flex;
    gap: 22px;
    flex: 1;
  }
  .nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .nav a:hover,
  .nav a[aria-current="page"] {
    color: var(--text);
  }
  .end {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .dl {
    margin-left: 10px;
  }
  .icon-btn {
    border: 0;
    background: transparent;
    color: var(--muted);
    width: 34px;
    height: 34px;
    border-radius: 6px;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .icon-btn:hover {
    color: var(--text);
    background: var(--bg-alt);
  }
  :global(.theme .moon) {
    display: none;
  }
  :global(:root[data-theme="dark"] .theme .moon) {
    display: block;
  }
  :global(:root[data-theme="dark"] .theme .sun) {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"]) .theme .moon) {
      display: block;
    }
    :global(:root:not([data-theme="light"]) .theme .sun) {
      display: none;
    }
  }
  .menu-btn,
  .mobile {
    display: none;
  }
  @media (max-width: 820px) {
    .nav,
    .dl {
      display: none;
    }
    .end {
      margin-left: auto;
    }
    .menu-btn {
      display: grid;
    }
    .mobile[data-open] {
      display: flex;
      flex-direction: column;
      padding: 4px 20px 14px;
      border-top: 1px solid var(--line);
    }
    .mobile a {
      padding: 10px 0;
      color: var(--text);
      text-decoration: none;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
