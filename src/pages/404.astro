---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page doesn't exist.">
  <section class="page-head nf">
    <div class="wrap">
      <p class="mono dim">404</p>
      <h1>This page doesn't exist</h1>
      <p class="lead">It may have moved, or the link has a typo. Try the <a href="/">home page</a> or the <a href="/tools/">list of tools</a>.</p>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding: 96px 0 120px;
    border-bottom: 0;
  }
  .nf .mono {
    margin-bottom: 8px;
  }
</style>
